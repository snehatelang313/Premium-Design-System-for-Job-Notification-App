{
  "meta": {
    "name": "Job Notification SaaS Design Tokens",
    "version": "1.1.0",
    "philosophy": [
      "calm",
      "intentional",
      "coherent",
      "confident"
    ]
  },
  "color": {
    "background": {
      "base": "#F7F6F3",
      "surface": "#FCFBF9",
      "surfaceMuted": "#F2F0EC"
    },
    "text": {
      "primary": "#111111",
      "secondary": "#3A3A3A",
      "muted": "#6B6B6B",
      "inverse": "#FFFFFF"
    },
    "accent": {
      "primary": "#8B0000",
      "hover": "#740000",
      "active": "#5C0000"
    },
    "border": {
      "subtle": "#E4E0D9",
      "faint": "#ECE9E3",
      "default": "#D2CCC2",
      "strong": "#B7AEA0"
    },
    "state": {
      "success": {
        "fg": "#2F5F44",
        "bg": "#E9F0EC",
        "border": "#BFD0C4"
      },
      "warning": {
        "fg": "#7A5A1D",
        "bg": "#F8F1E3",
        "border": "#E4D3AE"
      }
    }
  },
  "typography": {
    "fontFamily": {
      "heading": "\"Bitter\", \"Times New Roman\", Georgia, serif",
      "body": "\"Inter\", \"Segoe UI\", Roboto, Arial, sans-serif",
      "mono": "\"JetBrains Mono\", \"SFMono-Regular\", Consolas, monospace"
    },
    "fontSize": {
      "xs": "12px",
      "sm": "14px",
      "body": "16px",
      "bodyLarge": "18px",
      "h3": "24px",
      "h2": "36px",
      "h1": "48px"
    },
    "lineHeight": {
      "tight": 1.2,
      "normal": 1.6,
      "loose": 1.8
    },
    "fontWeight": {
      "regular": 400,
      "medium": 500,
      "semibold": 600,
      "bold": 700
    },
    "letterSpacing": {
      "tight": "-0.01em",
      "normal": "0",
      "wide": "0.02em"
    }
  },
  "spacing": {
    "0": "0",
    "xs": "8px",
    "sm": "16px",
    "md": "24px",
    "lg": "40px",
    "xl": "64px"
  },
  "radius": {
    "ui": "10px",
    "pill": "9999px"
  },
  "shadow": {
    "none": "none",
    "sm": "0 1px 2px rgba(17, 17, 17, 0.04)"
  },
  "motion": {
    "duration": {
      "none": "0ms",
      "standard": "175ms"
    },
    "easing": {
      "standard": "ease-in-out"
    },
    "constraints": [
      "Duration between 150ms and 200ms (token uses 175ms)",
      "No bounce or elastic easing",
      "No parallax"
    ]
  }
}
